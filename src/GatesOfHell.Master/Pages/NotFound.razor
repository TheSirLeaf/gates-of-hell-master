@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<PageTitle>Página perdida — Gates of Hell</PageTitle>

<div class="onboarding">
    <span class="eyebrow">Erro 404</span>
    <h1>Este corredor não existe.</h1>
    <p>O mestre procurou, mas não há nada aqui.</p>
    <div class="onboarding__actions">
        <a class="btn btn--primary" href="@Link("painel")"><Icon Name="eye" Size="16" /> Voltar ao painel</a>
        <a class="btn btn--ghost" href="@Link("fichas")"><Icon Name="users" Size="16" /> Ver fichas</a>
    </div>
</div>

@code {
    private string Link(string caminho) => Nav.BaseUri + caminho.TrimStart('/');
}
