@using System.Text

<div class="sheet-editor">
    <section class="card">
        <div class="card__head">
            <div>
                <div class="eyebrow">Perfil</div>
                <h2 class="card__title">Identidade</h2>
            </div>
            <span class="chip">@(string.IsNullOrWhiteSpace(Personagem.Classe) ? "Sem classe" : Personagem.Classe)</span>
        </div>

        <div class="form-grid form-grid--3">
            <label class="field field--wide">
                <span>Nome</span>
                <input class="input" @bind="Personagem.Nome" maxlength="80" disabled="@ReadOnly" placeholder="Nome da ficha" />
            </label>
            <label class="field">
                <span>Classe</span>
                <select class="input" value="@Personagem.Classe" @onchange="SelecionarClasse" disabled="@ReadOnly">
                    <option value="">Sem classe</option>
                    @foreach (var classe in Classes)
                    {
                        <option value="@classe.Nome">@classe.Nome</option>
                    }
                    @if (ClasseForaDaLista)
                    {
                        <option value="@Personagem.Classe">@Personagem.Classe</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Raça</span>
                <input class="input" @bind="Personagem.Raca" maxlength="60" disabled="@ReadOnly" placeholder="Ex.: Humano" />
            </label>
            <label class="field">
                <span>Armadura escolhida</span>
                <input class="input" @bind="Personagem.Armadura" maxlength="80" disabled="@ReadOnly" placeholder="Nome da armadura" />
            </label>
        </div>

        <p class="hint">
            Os testes usam um d20 por ponto do atributo e mantêm o maior resultado
            (<code>3d20kh1</code> para Físico 3), com no mínimo 1d20. A classe escolhida
            marca três perícias e concede três slots no orçamento, além dos slots de Mental.
        </p>
    </section>

    <section class="sheet-section">
        <div class="section-head">
            <div>
                <div class="eyebrow">Recursos</div>
                <h2 class="section-title">Vitalidade</h2>
            </div>
            <span class="section-note">Ajuste manualmente</span>
        </div>

        <div class="status-grid">
            <article class="status-card status-card--vida">
                <div class="status-card__head">
                    <span class="eyebrow">Vida</span>
                    <Icon Name="heart" Size="18" />
                </div>
                <input class="status-card__input" type="number" @bind="Personagem.Vida" disabled="@ReadOnly" aria-label="Vida" />
                <div class="status-card__hint">Recurso atual</div>
            </article>

            <article class="status-card status-card--postura">
                <div class="status-card__head">
                    <span class="eyebrow">Postura</span>
                    <Icon Name="shield" Size="18" />
                </div>
                <input class="status-card__input" type="number" @bind="Personagem.Postura" disabled="@ReadOnly" aria-label="Postura" />
                <div class="status-card__hint">Recurso atual</div>
            </article>

            <article class="status-card status-card--stamina">
                <div class="status-card__head">
                    <span class="eyebrow">Stamina</span>
                    <Icon Name="bolt" Size="18" />
                </div>
                <input class="status-card__input" type="number" @bind="Personagem.Stamina" disabled="@ReadOnly" aria-label="Stamina" />
                <div class="status-card__hint">Recurso atual</div>
            </article>

            <article class="status-card status-card--resistencia">
                <div class="status-card__head">
                    <span class="eyebrow">Resistência</span>
                    <Icon Name="shield" Size="18" />
                </div>
                <input class="status-card__input" type="number" @bind="Personagem.Resistencia" disabled="@ReadOnly" aria-label="Resistência" />
                <div class="status-card__hint">
                    @if (!string.IsNullOrWhiteSpace(Personagem.Armadura))
                    {
                        <span>@Personagem.Armadura</span>
                    }
                    else
                    {
                        <span>Valor da armadura escolhida</span>
                    }
                </div>
                @if (!ReadOnly && Armaduras.Count > 0)
                {
                    <div class="status-card__armors">
                        @foreach (var armadura in Armaduras.Take(4))
                        {
                            <button type="button" class="chip chip--button" title="Usar @armadura.Nome (@Valor(armadura.Valor))"
                                    @onclick="() => AplicarArmadura(armadura)">
                                @armadura.Nome
                                @if (armadura.Valor != 0)
                                {
                                    <span>@Valor(armadura.Valor)</span>
                                }
                            </button>
                        }
                    </div>
                }
            </article>
        </div>
    </section>

    <section class="card">
        <div class="section-head">
            <div>
                <div class="eyebrow">Atributos</div>
                <h2 class="section-title">O que sustenta a carne</h2>
            </div>
            <span class="section-note">Físico · Mental · Espiritual</span>
        </div>

        <div class="attr-grid">
            <label class="attr-card">
                <span class="attr-card__name">Físico</span>
                <input class="attr-card__input" type="number" min="0" max="99" @bind="Personagem.Fisico" disabled="@ReadOnly" aria-label="Físico" />
                <span class="attr-card__hint">teste: @Testes.Expressao(Personagem.Fisico)</span>
            </label>
            <label class="attr-card">
                <span class="attr-card__name">Mental</span>
                <input class="attr-card__input" type="number" min="0" max="99" @bind="Personagem.Mental" disabled="@ReadOnly" aria-label="Mental" />
                <span class="attr-card__hint">teste: @Testes.Expressao(Personagem.Mental)</span>
            </label>
            <label class="attr-card">
                <span class="attr-card__name">Espiritual</span>
                <input class="attr-card__input" type="number" min="0" max="99" @bind="Personagem.Espiritual" disabled="@ReadOnly" aria-label="Espiritual" />
                <span class="attr-card__hint">teste: @Testes.Expressao(Personagem.Espiritual)</span>
            </label>
        </div>
    </section>

    <section class="card">
        <div class="section-head">
            <div>
                <div class="eyebrow">Perícias</div>
                <h2 class="section-title">Treinamento</h2>
            </div>
            <span class="chip @(PericiasExcedidas ? "chip--danger" : "chip--ok")">
                @Personagem.PericiasComPontos de @Personagem.LimitePericias
            </span>
        </div>

        <p class="hint">
            Uma perícia por ponto em Mental, mais os três slots da classe.
            @if (Personagem.LimitePericias > 0)
            {
                <span>Orçamento atual: <strong>@Personagem.LimitePericias</strong>.</span>
            }
            @if (PericiasExcedidas)
            {
                <span class="text-danger">Você passou do orçamento — ajuste com o mestre.</span>
            }
        </p>

        <div class="skill-grid">
            @foreach (var grupo in Pericias.Grupos)
            {
                <div class="skill-group">
                    <h3 class="skill-group__title">@grupo</h3>
                    @foreach (var pericia in Pericias.DoGrupo(grupo))
                    {
                        <div class="skill-row @(EhPericiaDaClasse(pericia.Nome) ? "skill-row--class" : "")">
                            <span class="skill-row__name">
                                @pericia.Nome
                                @if (EhPericiaDaClasse(pericia.Nome))
                                {
                                    <span class="badge badge--class">classe</span>
                                }
                            </span>
                            <span class="skill-row__formula" title="Atributo + valor da perícia">
                                @Testes.ExpressaoDaPericia(Personagem, pericia)
                            </span>
                            <input class="input input--tiny" type="number" min="0" max="99"
                                   value="@Personagem.GetPericia(pericia.Chave)"
                                   @onchange="e => AlterarPericia(pericia.Chave, e)"
                                   disabled="@ReadOnly"
                                   aria-label="@pericia.Nome" />
                            @if (MostrarBotoesRolagem && !ReadOnly)
                            {
                                <button type="button" class="icon-btn skill-row__roll"
                                        title="Rolar @pericia.Nome"
                                        aria-label="Rolar @pericia.Nome"
                                        @onclick="() => RolarPericiaAsync(pericia)">
                                    <Icon Name="d20" Size="14" />
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public Personagem Personagem { get; set; } = new();
    [Parameter] public Config Config { get; set; } = new();
    [Parameter] public IReadOnlyList<ItemInventario> Itens { get; set; } = Array.Empty<ItemInventario>();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool MostrarBotoesRolagem { get; set; } = true;
    [Parameter] public IReadOnlyList<Classe> Classes { get; set; } = Array.Empty<Classe>();
    [Parameter] public EventCallback<SkillRollRequest> OnRollSkill { get; set; }

    private bool PericiasExcedidas => Personagem.PericiasComPontos > Personagem.LimitePericias;

    private IReadOnlyList<ItemInventario> Armaduras =>
        Itens.Where(i => i.Tipo == ItemTipos.Equipamento)
            .OrderBy(i => i.Nome)
            .ToList();

    private async Task RolarPericiaAsync(PericiaDef pericia)
    {
        var atributo = Testes.AtributoDoGrupo(pericia.Grupo);
        var expressao = Testes.ExpressaoDaPericia(Personagem, pericia);
        await OnRollSkill.InvokeAsync(new SkillRollRequest(pericia.Chave, pericia.Nome, atributo, expressao));
    }

    private void AlterarPericia(string chave, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var valor))
            Personagem.SetPericia(chave, valor);
    }

    private void AplicarArmadura(ItemInventario armadura)
    {
        Personagem.Armadura = armadura.Nome;
        Personagem.Resistencia = (int)Math.Round(armadura.Valor);
    }

    private bool ClasseForaDaLista =>
        !string.IsNullOrWhiteSpace(Personagem.Classe) &&
        !Classes.Any(c => string.Equals(c.Nome, Personagem.Classe, StringComparison.CurrentCultureIgnoreCase));

    private void SelecionarClasse(ChangeEventArgs args)
    {
        var nome = args.Value?.ToString() ?? "";
        var classe = Classes.FirstOrDefault(c =>
            string.Equals(c.Nome, nome, StringComparison.CurrentCultureIgnoreCase));

        Personagem.Classe = classe?.Nome ?? nome;
        Personagem.PericiaClasse = classe is null
            ? ""
            : string.Join("|", classe.Pericias);
    }

    private bool EhPericiaDaClasse(string nome)
    {
        var alvo = Normalizar(nome);
        return alvo.Length > 0 && Personagem.PericiasDaClasse.Any(p =>
            Normalizar(Pericias.NomeDaChave(p)) == alvo || Normalizar(p) == alvo);
    }

    private static string Normalizar(string texto)
    {
        var decomposto = texto.Normalize(NormalizationForm.FormD);
        var construtor = new StringBuilder(decomposto.Length);

        foreach (var caractere in decomposto)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(caractere) != UnicodeCategory.NonSpacingMark)
                construtor.Append(char.ToLowerInvariant(caractere));
        }

        return construtor.ToString().Trim();
    }

    private static string Valor(double valor) =>
        Math.Abs(valor - Math.Round(valor)) < 0.000001
            ? ((long)Math.Round(valor)).ToString(CultureInfo.InvariantCulture)
            : valor.ToString("0.##", CultureInfo.InvariantCulture);
}
