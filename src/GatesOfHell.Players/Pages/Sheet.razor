@page "/"
@page "/ficha"
@page "/ficha/{Id}"
@inject AuthService Auth
@inject GameApiClient Api
@inject GameSyncService Sync
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(_draft is null ? "Sua ficha — Gates of Hell" : $"{_draft.Nome} — Gates of Hell")</PageTitle>

@if (_carregando)
{
    <div class="page-loading">
        <span class="spinner"></span>
        <span>Abrindo a ficha...</span>
    </div>
}
else if (_draft is not { } ficha)
{
    <section class="onboarding">
        <div class="onboarding__sigil"><Icon Name="flame" Size="38" /></div>
        <span class="eyebrow">Ficha em branco</span>
        <h1>Nenhum nome no portão.</h1>
        <p>
            Crie a sua primeira ficha para começar. O mestre também pode cadastrar
            uma ficha para você e ela aparecerá aqui automaticamente.
        </p>
        <div class="onboarding__actions">
            <button type="button" class="btn btn--primary" @onclick="AbrirNova">
                <Icon Name="plus" Size="17" /> Criar ficha
            </button>
            <a class="btn btn--ghost" href="@Link("rolagens")">
                <Icon Name="d20" Size="17" /> Ver rolagens
            </a>
        </div>
    </section>
}
else
{
    <div class="page">
        <header class="page-head">
            <div class="page-head__main">
                <span class="eyebrow">Ficha de personagem</span>
                <h1>@ficha.Nome</h1>
                <div class="page-head__meta">
                    <span class="chip">@(string.IsNullOrWhiteSpace(ficha.Classe) ? "Sem classe" : ficha.Classe)</span>
                    <span class="chip">@(string.IsNullOrWhiteSpace(ficha.Raca) ? "Sem raça" : ficha.Raca)</span>
                    <span class="chip chip--hp"><Icon Name="heart" Size="12" /> @ficha.Vida</span>
                    <span class="chip"><Icon Name="shield" Size="12" /> @ficha.Resistencia</span>
                </div>
            </div>
            <div class="page-head__actions">
                @if (!string.IsNullOrWhiteSpace(_mensagem))
                {
                    <span class="save-state"><Icon Name="check" Size="14" /> @_mensagem</span>
                }
                <button type="button" class="btn btn--ghost" @onclick="AbrirNova">
                    <Icon Name="plus" Size="16" /> Nova
                </button>
                <button type="button" class="btn btn--primary" @onclick="SalvarAsync" disabled="@_salvando">
                    @if (_salvando)
                    {
                        <span class="spinner spinner--sm"></span>
                    }
                    else
                    {
                        <Icon Name="save" Size="16" />
                    }
                    Salvar ficha
                </button>
            </div>
        </header>

        @if (TemAtualizacaoRemota)
        {
            <div class="notice">
                <Icon Name="refresh" Size="17" />
                <span>O mestre atualizou esta ficha. Suas alterações locais ainda não foram salvas.</span>
                <button type="button" class="btn btn--ghost btn--xs" @onclick="RecarregarDoServidor">Recarregar</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_erro))
        {
            <div class="alert alert--warn content-alert">
                <Icon Name="alert" Size="17" />
                <span>@_erro</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_aviso))
        {
            <div class="alert alert--warn content-alert">
                <Icon Name="alert" Size="17" />
                <span>@_aviso</span>
            </div>
        }

        <div class="sheet-layout">
            <div class="sheet-layout__main">
                <SheetEditor Personagem="ficha"
                             Config="Configuracao"
                             Itens="ItensDaFicha"
                             Classes="Classes"
                             OnRollSkill="RolarPericiaAsync" />

                <InventoryPanel PersonagemId="@ficha.Id"
                                Itens="ItensDaFicha"
                                Editable="false"
                                OnChanged="AtualizarAsync" />
            </div>

            <aside class="sheet-layout__aside">
                <DiceRollerPanel Contexto="@ficha.Nome"
                                 PersonagemId="@ficha.Id"
                                 Placeholder="Ex.: d20+5 ataque"
                                 OnRolled="AtualizarAsync" />

                <section class="card">
                    <div class="section-head section-head--tight">
                        <div>
                            <div class="eyebrow">Mesa</div>
                            <h2 class="section-title">Últimas rolagens</h2>
                        </div>
                        <a class="text-button" href="@Link("rolagens")">ver todas</a>
                    </div>

                    <RollFeed Entries="Rolagens" Compact="true" Limit="6"
                              EmptyText="A mesa ainda não rolou nada." />
                </section>
            </aside>
        </div>
    </div>
}

@if (_modalNova)
{
    <div class="modal-backdrop" @onclick="FecharNova">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal__head">
                <div>
                    <span class="eyebrow">Nova ficha</span>
                    <h2 class="modal__title">Forjar um personagem</h2>
                </div>
                <button type="button" class="icon-btn" title="Fechar" @onclick="FecharNova">
                    <Icon Name="close" Size="18" />
                </button>
            </div>

            <form @onsubmit="CriarFichaAsync" @onsubmit:preventDefault>
                <div class="form-grid">
                    <label class="field field--wide">
                        <span>Nome</span>
                        <input class="input" @bind="_novoNome" @bind:event="oninput" maxlength="80" placeholder="Quem atravessa o portão?" autofocus />
                    </label>
                    <label class="field">
                        <span>Classe</span>
                        <input class="input" @bind="_novaClasse" @bind:event="oninput" maxlength="60" placeholder="Ex.: Caçador" />
                    </label>
                    <label class="field">
                        <span>Raça</span>
                        <input class="input" @bind="_novaRaca" @bind:event="oninput" maxlength="60" placeholder="Ex.: Humano" />
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(_erroNova))
                {
                    <div class="alert alert--warn">
                        <Icon Name="alert" Size="16" />
                        <span>@_erroNova</span>
                    </div>
                }

                <div class="modal__actions">
                    <button type="button" class="btn btn--ghost" @onclick="FecharNova">Cancelar</button>
                    <button type="submit" class="btn btn--primary" disabled="@_criando">
                        @if (_criando)
                        {
                            <span class="spinner spinner--sm"></span>
                        }
                        else
                        {
                            <Icon Name="flame" Size="16" />
                        }
                        Criar ficha
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }
    [SupplyParameterFromQuery(Name = "novo")] public bool Novo { get; set; }

    private readonly DiceRoller _roller = new();
    private Personagem? _draft;
    private string? _carregadoId;
    private bool _carregando = true;
    private bool _dadosProntos;
    private bool _salvando;
    private bool _criando;
    private bool _modalNova;
    private string? _mensagem;
    private string? _erro;
    private string? _aviso;
    private string? _erroNova;
    private string _novoNome = "";
    private string _novaClasse = "";
    private string _novaRaca = "";

    private IReadOnlyList<Personagem> Personagens =>
        (Sync.State?.Personagens ?? [])
        .OrderBy(p => p.Nome, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private Config Configuracao => Sync.State?.Config ?? new Config();

    private IReadOnlyList<Classe> Classes => Sync.State?.Classes ?? [];

    private IReadOnlyList<ItemInventario> ItensDaFicha =>
        (Sync.State?.Itens ?? [])
        .Where(i => i.PersonagemId == _draft?.Id)
        .ToList();

    private IReadOnlyList<RollEntry> Rolagens => Sync.State?.Rolagens ?? [];

    private string Link(string caminho) => Nav.BaseUri + caminho.TrimStart('/');

    private Personagem? Servidor =>
        _draft is null ? null : Sync.State?.Personagens.FirstOrDefault(p => p.Id == _draft.Id);

    private bool TemAtualizacaoRemota =>
        _draft is not null && Servidor is not null && !_salvando &&
        !string.Equals(Servidor.AtualizadoEm, _draft.AtualizadoEm, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("login");
            return;
        }

        Sync.Changed += OnSyncChanged;
        Sync.Start();
        await Sync.RefreshAsync();

        _dadosProntos = true;
        CarregarFicha();

        if (Novo)
            AbrirNova();

        _carregando = false;
    }

    protected override void OnParametersSet()
    {
        if (!_dadosProntos)
            return;

        if (!string.IsNullOrWhiteSpace(Id) && Id != _carregadoId)
            CarregarFicha();

        if (Novo && !_modalNova)
            AbrirNova();
    }

    private void OnSyncChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_draft is null && Personagens.Count > 0)
                CarregarFicha();

            StateHasChanged();
        });
    }

    private void CarregarFicha(bool forcar = false)
    {
        var disponiveis = Personagens;
        if (disponiveis.Count == 0)
        {
            _draft = null;
            _carregadoId = null;
            return;
        }

        var alvo = !string.IsNullOrWhiteSpace(Id)
            ? disponiveis.FirstOrDefault(p => p.Id == Id)
            : null;

        alvo ??= disponiveis[0];

        if (!forcar && _draft is not null && _carregadoId == alvo.Id)
            return;

        _draft = alvo.Clone();
        _carregadoId = alvo.Id;
        _mensagem = null;
        _erro = null;
        _aviso = null;
    }

    private void RecarregarDoServidor()
    {
        if (Servidor is null)
            return;

        _draft = Servidor.Clone();
        _mensagem = "Ficha recarregada";
        _erro = null;
        _aviso = null;
    }

    private async Task SalvarAsync()
    {
        if (_draft is null)
            return;

        _erro = null;
        _mensagem = null;
        _salvando = true;

        try
        {
            var salvo = await Api.SalvarPersonagemAsync(_draft);
            _draft = salvo.Clone();
            _mensagem = $"Salvo às {DateTime.Now:HH:mm}";
            await Sync.RefreshAsync();
        }
        catch (GameApiException ex)
        {
            _erro = ex.Message;
        }
        catch (Exception ex)
        {
            _erro = $"Não foi possível salvar: {ex.Message}";
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task RolarPericiaAsync(SkillRollRequest pedido)
    {
        if (_draft is null)
            return;

        _erro = null;
        _aviso = null;
        _mensagem = null;

        try
        {
            var resultados = _roller.RollCommand($"{pedido.Expressao} {pedido.Nome}");
            await Api.SalvarRolagemAsync(_draft.Nome, _draft.Id, resultados);
            _mensagem = $"{pedido.Nome} rolado";
            await Sync.RefreshAsync();
        }
        catch (DiceRollException ex)
        {
            _erro = ex.Message;
        }
        catch (GameApiException ex)
        {
            _aviso = $"A rolagem foi calculada, mas não foi registrada: {ex.Message}";
        }
    }

    private async Task AtualizarAsync()
    {
        await Sync.RefreshAsync();
    }

    private void AbrirNova()
    {
        if (_modalNova)
            return;

        _novoNome = "";
        _novaClasse = "";
        _novaRaca = "";
        _erroNova = null;
        _modalNova = true;
    }

    private void FecharNova()
    {
        _modalNova = false;
        _erroNova = null;
    }

    private async Task CriarFichaAsync()
    {
        _erroNova = null;

        if (string.IsNullOrWhiteSpace(_novoNome) || _novoNome.Trim().Length < 2)
        {
            _erroNova = "Dê um nome ao seu personagem.";
            return;
        }

        _criando = true;
        try
        {
            var criada = await Api.CriarPersonagemAsync(_novoNome.Trim(), _novaClasse.Trim(), _novaRaca.Trim());
            await Sync.RefreshAsync();

            _modalNova = false;
            _draft = criada.Clone();
            _carregadoId = criada.Id;
            _mensagem = "Ficha criada";
            _erro = null;
            _aviso = null;

            Nav.NavigateTo($"ficha/{criada.Id}", replace: true);
            StateHasChanged();
        }
        catch (GameApiException ex)
        {
            _erroNova = ex.Message;
        }
        catch (Exception ex)
        {
            _erroNova = $"Não foi possível criar a ficha: {ex.Message}";
        }
        finally
        {
            _criando = false;
        }
    }

    public void Dispose()
    {
        Sync.Changed -= OnSyncChanged;
    }
}
